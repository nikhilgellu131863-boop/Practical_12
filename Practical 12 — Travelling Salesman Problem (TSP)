import java.util.*;

public class TSP {
    static int tsp(int[][] cost, int mask, int pos, int[][] dp) {
        int n = cost.length;

        if (mask == (1 << n) - 1) {
            return cost[pos][0];
        }

        if (dp[mask][pos] != -1) {
            return dp[mask][pos];
        }

        int ans = Integer.MAX_VALUE / 2;

        for (int city = 0; city < n; city++) {
            if ((mask & (1 << city)) == 0) {
                ans = Math.min(ans,
                    cost[pos][city] +
                    tsp(cost, mask | (1 << city), city, dp));
            }
        }

        return dp[mask][pos] = ans;
    }

    public static void main(String[] args) {
        int[][] cost = {
            {0, 10, 15, 20},
            {10, 0, 35, 25},
            {15, 35, 0, 30},
            {20, 25, 30, 0}
        };

        int n = cost.length;
        int[][] dp = new int[1 << n][n];

        for (int[] row : dp) {
            Arrays.fill(row, -1);
        }

        System.out.println("Minimum Tour Cost: " +
            tsp(cost, 1, 0, dp));
    }
}
